{
  "name": "redvblue",
  "version": "1.0.0",
  "description": "Multiplayer Three.js game with Bun WebSocket server",
  "main": "src/server/index.js",
  "scripts": {
    "start": "bun src/server/index.js",
    "dev": "bun --watch src/server/index.js",
    "build": "bun build ./src/server/index.js --compile --outfile redvblue"
  },
  "dependencies": {
    "three": "^0.161.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.8.2"
  },
  "type": "module"
}
